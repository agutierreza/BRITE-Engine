#pragma once

// GENERATED BY CMAKE from assets/shaders/pbr.vs and assets/shaders/pbr.fs.
// Edit those files, not this one: a build after editing them reconfigures and
// rewrites this header (they are listed in CMAKE_CONFIGURE_DEPENDS).
//
// The shader lives in the binary so that a client draws lit models without
// staging any asset files -- the whole reason it is embedded rather than loaded
// from "shaders/pbr.fs" relative to a working directory nobody controls.

namespace BRITE::Backends::Raylib::EmbeddedShaders {

inline constexpr const char* PBR_VERTEX = R"GLSL(@BRITE_PBR_VS@)GLSL";

inline constexpr const char* PBR_FRAGMENT = R"GLSL(@BRITE_PBR_FS@)GLSL";

} // namespace BRITE::Backends::Raylib::EmbeddedShaders
